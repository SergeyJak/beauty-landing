# Environment variables example
# Copy this file to .env.local and fill in your values

# Public site URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# CMS / MongoDB
MONGODB_URI=mongodb+srv://...
MONGODB_DB=beauty_prod

# Admin access (first CMS iteration)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Contact Information
NEXT_PUBLIC_PHONE=+1234567890
NEXT_PUBLIC_EMAIL=contact@beautyservice.com
NEXT_PUBLIC_ADDRESS=123 Beauty Street, Fashion District, NY 10001

# Social Links
NEXT_PUBLIC_WHATSAPP=https://wa.me/1234567890
NEXT_PUBLIC_TELEGRAM=https://t.me/username
NEXT_PUBLIC_INSTAGRAM=https://instagram.com/beautyservice

# Maps
NEXT_PUBLIC_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=...
